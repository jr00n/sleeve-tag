# Voorbeeldinstellingen voor docker-compose.yml.
#
# Kopieer dit bestand naar `.env` en pas aan wat voor jouw NAS geldt:
#
#     cp .env.example .env
#
# `.env` staat in .gitignore: het bevat het pad van jouw share en hoort niet in
# de repository. Alleen MUSIC_HOST_PATH is verplicht; de rest heeft in
# docker-compose.yml al een standaardwaarde en mag weg.

# Het pad van de muziekshare op de NAS. Dit is het enige NAS-specifieke
# gegeven: de app kent het nooit, want in de container heet de map altijd
# /music. Op de UGREEN vind je het pad met `ls /volume1`.
MUSIC_HOST_PATH=/volume1/Multimedia/music

# Eigenaar en groep die geschreven bestanden moeten krijgen — dezelfde als de
# rest van de share, anders ziet Navidrome ze niet meer goed. Kijk met `ls -n`
# in de muziekmap welke uid en gid daar staan; op deze UGREEN is dat 1000 en 10.
PUID=1000
PGID=10

# De poort op de NAS. Alleen aanpassen als 8080 daar al bezet is; binnen de
# container blijft het 8080.
HOST_PORT=8080

# Album art: bovengrens aan de resolutie van een embedded hoes, de
# JPEG-kwaliteit waarmee een verkleinde hoes wordt opgeslagen, en de bovengrens
# aan een upload in megabytes.
MAX_ART_SIZE=1000x1000
ART_QUALITY=85
MAX_UPLOAD_MB=10

# Logniveau. Op `debug` logt elk verzoek uitgebreid mee.
LOG_LEVEL=info

# Op `true` komt er bij elke schrijfactie een <naam>.bak naast het bestand.
# Standaard uit, om de share niet te vervuilen: het schrijven is sowieso
# atomisch, dus het origineel raakt nooit halverwege kwijt.
BACKUP_ON_WRITE=false
